
{% extends 'base.html.twig' %}

{% block title %}Uitgaven - Budget Buddy{% endblock %}

{% block body %}

<h1>Uitgaven</h1>
<p>Hier zie je alle geregistreerde uitgaven.</p>

<a href="{{ path('app_expense_transaction_new') }}"
   class="btn btn-primary mb-3">
    + Nieuwe uitgave
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Categorie</th>
            <th>Bedrag</th>
            <th>Datum</th>
            <th>Acties</th>
        </tr>
    </thead>

    <tbody>
        {% for transaction in expense_transactions %}
            <tr>
                <td>{{ transaction.id }}</td>

                <td>{{ transaction.category.name }}</td>

                <td class="text-danger">
                    €{{ transaction.amount|number_format(2, ',', '.') }}
                </td>

                <td>
                    {{ transaction.createdAt|date('d-m-Y H:i') }}
                </td>

                <td>
                    <a href="{{ path('app_expense_transaction_show', {'id': transaction.id}) }}"
                       class="btn btn-sm btn-info">
                        Bekijken
                    </a>

                    <a href="{{ path('app_expense_transaction_edit', {'id': transaction.id}) }}"
                       class="btn btn-sm btn-warning">
                        Bewerken
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">
                    Geen uitgaven gevonden.
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>

{% if totalPages > 1 %}
    <nav aria-label="Uitgaven pagina's">
        <ul class="pagination">

            {% if page > 1 %}
                <li class="page-item">
                    <a class="page-link"
                       href="{{ path('app_expense_transaction_index', {'page': page - 1}) }}">
                        Vorige
                    </a>
                </li>
            {% endif %}

            {% for number in 1..totalPages %}
                <li class="page-item {{ page == number ? 'active' : '' }}">
                    <a class="page-link"
                       href="{{ path('app_expense_transaction_index', {'page': number}) }}">
                        {{ number }}
                    </a>
                </li>
            {% endfor %}

            {% if page < totalPages %}
                <li class="page-item">
                    <a class="page-link"
                       href="{{ path('app_expense_transaction_index', {'page': page + 1}) }}">
                        Volgende
                    </a>
                </li>
            {% endif %}

        </ul>
    </nav>
{% endif %}

{% endblock %}
