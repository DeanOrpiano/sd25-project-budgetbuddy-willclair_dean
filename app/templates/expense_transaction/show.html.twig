{% extends 'base.html.twig' %}

{% block title %}ExpenseTransaction{% endblock %}

{% block body %}
    <h1>ExpenseTransaction</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ expense_transaction.id }}</td>
            </tr>
            <tr>
                <th>Amount</th>
                <td>{{ expense_transaction.amount }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ expense_transaction.createdAt ? expense_transaction.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_expense_transaction_index') }}">back to list</a>

    <a href="{{ path('app_expense_transaction_edit', {'id': expense_transaction.id}) }}">edit</a>

    {{ include('expense_transaction/_delete_form.html.twig') }}
{% endblock %}
