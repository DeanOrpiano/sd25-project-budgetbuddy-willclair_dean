{% extends 'base.html.twig' %}

{% block title %}BudgetTransaction{% endblock %}

{% block body %}
    <h1>BudgetTransaction</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ budget_transaction.id }}</td>
            </tr>
            <tr>
                <th>Amount</th>
                <td>{{ budget_transaction.amount }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ budget_transaction.createdAt ? budget_transaction.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_budget_transaction_index') }}">back to list</a>

    <a href="{{ path('app_budget_transaction_edit', {'id': budget_transaction.id}) }}">edit</a>

    {{ include('budget_transaction/_delete_form.html.twig') }}
{% endblock %}
