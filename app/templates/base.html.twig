
<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Budget Buddy{% endblock %}</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    {% block stylesheets %}
    {% endblock %}

    <!-- Symfony JavaScript -->
    {% block javascripts %}
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
    {% endblock %}
</head>

<body class="bg-light">

<div class="container-fluid">
    <div class="row min-vh-100">

        <!-- Sidebar -->
        <aside class="col-12 col-md-3 col-lg-2 bg-dark text-white p-3">

            <a href="{{ path('app_dashboard') }}"
               class="text-white text-decoration-none fs-4 fw-bold d-block mb-4">
                Budget Buddy
            </a>

            <nav class="nav flex-column">

                <a href="{{ path('app_dashboard') }}"
                   class="nav-link text-white">
                    Dashboard
                </a>

                <a href="{{ path('app_category_index') }}"
                   class="nav-link text-white">
                    Categorieën
                </a>

                <a href="{{ path('app_budget_transaction_index') }}"
                class="nav-link text-white">
                    Budgetten
                </a>

                
<a href="{{ path('app_expense_transaction_index') }}"
   class="nav-link text-white">
    Uitgaven
</a>


            </nav>

        </aside>

        <!-- Main Content -->
        <main class="col-12 col-md-9 col-lg-10 p-4">

            {% block body %}
            {% endblock %}

        </main>

    </div>
</div>

</body>
</html>
