
<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Budget Buddy{% endblock %}</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    {% block stylesheets %}
    {% endblock %}

    <!-- Symfony JavaScript -->
    {% block javascripts %}
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
    {% endblock %}
</head>

<body class="bg-light">


<!-- Navigation -->
<nav class="navbar navbar-dark bg-dark">
    <div class="container">

        <!-- Budget Buddy logo goes to Dashboard -->
        <a class="navbar-brand"
           href="{{ path('app_dashboard') }}">
            Budget Buddy
        </a>

        <!-- Categories goes to Category List -->
        <a class="nav-link text-white"
           href="{{ path('app_category_index') }}">
            Categorieën
        </a>

    </div>
</nav>


    <!-- Main Content -->
    <main class="container mt-4">

        {% block body %}
        {% endblock %}

    </main>

</body>
</html>
