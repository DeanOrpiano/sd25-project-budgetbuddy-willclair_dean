
{% extends 'base.html.twig' %}

{% block title %}Dashboard - Budget Buddy{% endblock %}

{% block body %}

<h1>Dashboard</h1>
<p>Welkom bij Budget Buddy!</p>

<h3>Actieve categorieën</h3>

<a href="{{ path('app_category_new') }}"
   class="btn btn-primary mb-3">
    + Nieuwe categorie
</a>


<div class="row">
    {% for category in categories %}
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        {{ category.name }}
                    </h5>

                    <span class="badge bg-success">
                        Actief
                    </span>
                </div>
            </div>
        </div>
    {% else %}
        <p>Geen actieve categorieën gevonden.</p>
    {% endfor %}
</div>

{% endblock %}
