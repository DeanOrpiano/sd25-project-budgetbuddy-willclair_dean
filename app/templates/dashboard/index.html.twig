
{% extends 'base.html.twig' %}

{% block title %}Dashboard - Budget Buddy{% endblock %}

{% block body %}

<h1>Dashboard</h1>
<p>Welkom bij Budget Buddy!</p>

<!-- Budget Summary -->
<div class="row mb-4">

    <!-- Total Budget -->
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Totaal budget</h5>

                <h2>
                    €{{ totalBudget|number_format(2, ',', '.') }}
                </h2>
            </div>
        </div>
    </div>

    <!-- Today's Income -->
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">
                    Inkomsten vandaag
                </h5>

                <h2 class="text-success">
                    €{{ todayIncome|number_format(2, ',', '.') }}
                </h2>
            </div>
        </div>
    </div>

</div>

<!-- Categories -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Actieve categorieën</h3>

    <a href="{{ path('app_category_new') }}"
       class="btn btn-primary">
        + Nieuwe categorie
    </a>
</div>

<div class="row">
    {% for category in categories %}
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">
                        {{ category.name }}
                    </h5>

                    <span class="badge bg-success">
                        Actief
                    </span>

                    <p class="mt-3 mb-0">
                        Budget:
                        <strong>
                            €{{ (budgets[category.id]|default(0))|number_format(2, ',', '.') }}
                        </strong>
                    </p>

                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12">
            <p>Geen actieve categorieën gevonden.</p>
        </div>
    {% endfor %}
</div>

{% endblock %}
