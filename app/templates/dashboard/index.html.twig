
{% extends 'base.html.twig' %}

{% block title %}Dashboard - Budget Buddy{% endblock %}

{% block body %}

<h1>Dashboard</h1>
<p>Welkom bij Budget Buddy!</p>

<!-- Financial Summary -->
<div class="row mb-4">

    <!-- Total Budget -->
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5>Totaal budget</h5>
                <h2>
                    €{{ totalBudget|number_format(2, ',', '.') }}
                </h2>
            </div>
        </div>
    </div>

    <!-- Today's Income -->
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5>Inkomsten vandaag</h5>
                <h2 class="text-success">
                    €{{ todayIncome|number_format(2, ',', '.') }}
                </h2>
            </div>
        </div>
    </div>

    <!-- Total Expenses -->
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5>Totaal uitgaven</h5>
                <h2 class="text-danger">
                    €{{ totalExpenses|number_format(2, ',', '.') }}
                </h2>
            </div>
        </div>
    </div>

    <!-- Remaining Budget -->
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5>Beschikbaar budget</h5>
                <h2 class="{{ remainingBudget < 0 ? 'text-danger' : 'text-success' }}">
                    €{{ remainingBudget|number_format(2, ',', '.') }}
                </h2>
            </div>
        </div>
    </div>

    <!-- Today's Expenses -->
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5>Uitgaven vandaag</h5>
                <h2 class="text-danger">
                    €{{ todayExpenses|number_format(2, ',', '.') }}
                </h2>
            </div>
        </div>
    </div>

</div>

<!-- Active Categories -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Actieve categorieën</h3>

    <a href="{{ path('app_category_new') }}"
       class="btn btn-primary">
        + Nieuwe categorie
    </a>
</div>

<div class="row">

    {% for category in categories %}

        {% set budget = budgets[category.id]|default(0) %}
        {% set spent = expenses[category.id]|default(0) %}
        {% set remaining = budget - spent %}

        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">
                        {{ category.name }}
                    </h5>

                    <span class="badge bg-success">
                        Actief
                    </span>

                    <p class="mt-3 mb-1">
                        Budget:
                        €{{ budget|number_format(2, ',', '.') }}
                    </p>

                    <p class="mb-1">
                        Uitgaven:
                        €{{ spent|number_format(2, ',', '.') }}
                    </p>

                    <p class="mb-0">
                        <strong class="{{ remaining < 0 ? 'text-danger' : 'text-success' }}">
                            Beschikbaar:
                            €{{ remaining|number_format(2, ',', '.') }}
                        </strong>
                    </p>

                </div>
            </div>
        </div>

    {% else %}
        <p>Geen actieve categorieën gevonden.</p>
    {% endfor %}

</div>

{% endblock %}
